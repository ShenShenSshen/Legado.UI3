<Application
    x:Class="Legado.UI3.ReaderApplication"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="LegadoPrimaryBrush" Color="#315DA8"/>
                    <SolidColorBrush x:Key="LegadoPrimaryTextBrush" Color="White"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="LegadoPrimaryBrush" Color="#A8C9FF"/>
                    <SolidColorBrush x:Key="LegadoPrimaryTextBrush" Color="#172A45"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="LegadoPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
                    <SolidColorBrush x:Key="LegadoPrimaryTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="LegadoPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource LegadoPrimaryBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource LegadoPrimaryTextBrush}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
