<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Legado.UI3</AssemblyName>
    <RootNamespace>Legado.UI3</RootNamespace>
    <Product>Legado·UI3</Product>
    <Version>1.0.3</Version>
    <Description>Legado·UI3</Description>
    <ApplicationIcon>Assets/Legado.UI3.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);upstream/**;test-artifacts/**;publish/**</DefaultItemExcludes>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <Compile Include="App/**/*.cs" />
    <Compile Include="Core/**/*.cs" />
    <Content Include="Assets/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup Condition="'$(LegadoUI3SelfTest)' == 'true'">
    <DefineConstants>$(DefineConstants);LEGADO_UI3_SELF_TEST</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(LegadoUI3SelfTest)' == 'true'">
    <Compile Include="Tests/Smoke.cs" />
  </ItemGroup>
  <Target Name="IncludeUnpackagedWinUIResources" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <!-- The unpackaged SDK build generates these resources but omits them from publish. -->
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri" RelativePath="$(AssemblyName).pri" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(TargetDir)App.xbf" RelativePath="App.xbf" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
